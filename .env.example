# Server-side OpenAI API key (never exposed to the browser)
OPENAI_API_KEY=

# Realtime model and voice defaults
REALTIME_MODEL=gpt-realtime
REALTIME_VOICE=marin

# Port for the local token + booking server
# Keep this in sync with Vite proxy target
PORT=8787

# Frontend token URL (Vite will proxy /api to the local server during dev)
VITE_VOICE_TOKEN_URL=/api/voice/token

# Supabase (used by Vercel serverless API routes in production)
# Get these from your Supabase project settings. Do NOT expose the service key to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Client-side Supabase (Vite) for reads with RLS
# Safe to expose anon key to the browser (ensure RLS policies are correct)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
