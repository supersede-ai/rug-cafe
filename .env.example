# Server-side OpenAI API key (never exposed to the browser)
OPENAI_API_KEY=

# Realtime model and voice defaults
REALTIME_MODEL=gpt-realtime
REALTIME_VOICE=marin

# Transcription (for audio-only user intent, analytics, etc.)
# Disable to reduce cost or if you rely solely on the agent calling end_session.
VITE_VOICE_TRANSCRIBE_ENABLED=true
# Choose a lightweight transcription model; keep it small and fast.
# If your account has a cheaper option (e.g., a nano-tier transcribe model), set it here.
VITE_VOICE_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Delay (ms) before disconnect when the agent says goodbye and calls the tool.
# Allows the spoken goodbye to finish. 0–5000ms.
VITE_VOICE_GOODBYE_DELAY_MS=1200

# Port for the local token + booking server
# Keep this in sync with Vite proxy target
PORT=8787

# Frontend token URL (Vite will proxy /api to the local server during dev)
VITE_VOICE_TOKEN_URL=/api/voice/token

# Supabase (used by Vercel serverless API routes in production)
# Get these from your Supabase project settings. Do NOT expose the service key to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Client-side Supabase (Vite) for reads with RLS
# Safe to expose anon key to the browser (ensure RLS policies are correct)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
